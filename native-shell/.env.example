# Optional local override. On your Mac, use your LAN IP (not localhost) so
# Expo Go on an iPhone can reach the current workspace.
# Example: EXPO_PUBLIC_ECHOO_WEB_URL=http://192.168.1.42:8080/app.html

# A restricted mobile key is embedded in the native app binary; it is not a server secret.
# Keep backend-only Google keys in Supabase secrets, never in this file.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# Leave blank to use Echoo's production app page.
EXPO_PUBLIC_ECHOO_WEB_URL=
